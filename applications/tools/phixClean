#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# phixClean — clean a PhiX case directory of generated artifacts.
# (OpenFOAM analogue: foamCleanCase / foamCleanTutorials)
#
#   phixClean [dir]        show what would be removed, then ask
#   phixClean -f [dir]     remove without asking
#
# Removes: output/ output.*/ *.vts *.dat *.field *.png *.log run.log
# Never touches: sources, settings/, tables/, CMakeLists.txt, binaries.
# ---------------------------------------------------------------------------
set -u

force=0
dir="."
for a in "$@"; do
    case "$a" in
        -f) force=1 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        *) dir="$a" ;;
    esac
done

cd "$dir" || exit 1

mapfile -t victims < <(
    { find . -maxdepth 1 -type d \( -name "output" -o -name "output.*" \);
      find . -maxdepth 2 -type f \( -name "*.vts" -o -name "*.dat" \
            -o -name "*.field" -o -name "*.png" -o -name "*.log" \
            -o -name "run.log" \) ! -path "./settings/*" ! -path "./tables/*";
    } 2>/dev/null | sort -u)

if [ "${#victims[@]}" -eq 0 ]; then
    echo "phixClean: nothing to clean in $(pwd)"
    exit 0
fi

echo "phixClean: will remove from $(pwd):"
printf '  %s\n' "${victims[@]}"

if [ "$force" -ne 1 ]; then
    read -r -p "proceed? [y/N] " ans
    case "$ans" in y|Y|yes) ;; *) echo "aborted"; exit 1 ;; esac
fi

for v in "${victims[@]}"; do
    rm -rf -- "$v"
done
echo "phixClean: done (${#victims[@]} entries removed)"
