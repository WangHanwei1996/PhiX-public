#!/usr/bin/env python3
# ---------------------------------------------------------------------------
# phixInfo — inspect PhiX .field binary files / list case output steps.
# (OpenFOAM analogue: foamListTimes + a dash of checkMesh's summary style)
#
#   phixInfo phi_100.field [more.field ...]   header + min/max/mean/L2/NaN
#   phixInfo -l [output_dir]                  group output files by field,
#                                             list available steps
# ---------------------------------------------------------------------------
import math
import os
import re
import struct
import sys


def read_field(path):
    with open(path, "rb") as fh:
        header = {}
        while True:
            line = fh.readline().decode("ascii", errors="replace")
            if not line:
                raise ValueError(f"{path}: unexpected EOF in header")
            if line.strip() == "---":
                break
            if line.startswith("#"):
                continue
            parts = line.split()
            if parts and parts[0] == "name":
                header["name"] = parts[1] if len(parts) > 1 else ""
            elif parts and parts[0] == "nx":
                header["nx"], header["ny"], header["nz"] = \
                    int(parts[1]), int(parts[3]), int(parts[5])
            elif parts and parts[0] == "ghost":
                header["ghost"] = int(parts[1])
        n = header["nx"] * header["ny"] * header["nz"]
        raw = fh.read(8 * n)
        if len(raw) != 8 * n:
            raise ValueError(f"{path}: truncated data "
                             f"({len(raw)} of {8 * n} bytes)")
        data = struct.unpack(f"<{n}d", raw)
    return header, data


def show(path):
    h, d = read_field(path)
    n = len(d)
    finite = [v for v in d if math.isfinite(v)]
    nbad = n - len(finite)
    mn = min(finite) if finite else float("nan")
    mx = max(finite) if finite else float("nan")
    mean = sum(finite) / len(finite) if finite else float("nan")
    l2 = math.sqrt(sum(v * v for v in finite) / len(finite)) if finite else 0.0
    print(f"{path}")
    print(f"  name  {h.get('name', '?')}    "
          f"grid {h['nx']} x {h['ny']} x {h['nz']}    ghost {h.get('ghost', '?')}")
    print(f"  min {mn:.6g}   max {mx:.6g}   mean {mean:.6g}   L2 {l2:.6g}"
          + (f"   NaN/Inf: {nbad} !!" if nbad else ""))


def list_case(d):
    pat = re.compile(r"^(.*)_(\d+)\.(field|vts|dat)$")
    groups = {}
    for f in sorted(os.listdir(d)):
        m = pat.match(f)
        if m:
            groups.setdefault((m.group(1), m.group(3)), []).append(
                int(m.group(2)))
    if not groups:
        print(f"{d}: no PhiX output files (name_step.field/.vts/.dat)")
        return
    for (name, ext), steps in sorted(groups.items()):
        steps.sort()
        print(f"  {name} (.{ext}): {len(steps)} steps  "
              f"[{steps[0]} .. {steps[-1]}]")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__ or "phixInfo <file.field ...> | phixInfo -l [dir]")
        return 0
    if argv[0] == "-l":
        list_case(argv[1] if len(argv) > 1 else "output")
        return 0
    for p in argv:
        show(p)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
