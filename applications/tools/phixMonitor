#!/usr/bin/env python3
# ---------------------------------------------------------------------------
# phixMonitor — parse/tail a PhiX run log and report progress.
# (OpenFOAM analogue: foamMonitor / foamLog)
#
# Understands the OutputWriter lines:
#     [progress] step=1200  t=1.234e-03  elapsed=45.6s
#
#   phixMonitor run.log                 summary of a finished/growing log
#   phixMonitor run.log -f              follow (like tail -f) with live rate
#   phixMonitor run.log -n 100000       add ETA for a planned total step count
# ---------------------------------------------------------------------------
import re
import sys
import time

PAT = re.compile(
    r"\[progress\]\s+step=(\d+)\s+t=([0-9.eE+-]+)\s+elapsed=([0-9.]+)s")


def parse(line):
    m = PAT.search(line)
    if not m:
        return None
    return int(m.group(1)), float(m.group(2)), float(m.group(3))


def report(first, last, total):
    s0, _, e0 = first
    s1, t1, e1 = last
    de = e1 - e0
    ds = s1 - s0
    rate = ds / de if de > 0 else float("nan")
    line = (f"  step {s1}   t = {t1:.4e}   elapsed {e1:.1f}s   "
            f"{rate:.1f} steps/s")
    if total and rate > 0:
        remaining = (total - s1) / rate
        line += f"   ETA {remaining / 60:.1f} min (of {total})"
    print(line)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__ or "phixMonitor <log> [-f] [-n totalSteps]")
        return 0
    path = argv[0]
    follow = "-f" in argv
    total = 0
    if "-n" in argv:
        total = int(argv[argv.index("-n") + 1])

    entries = []
    with open(path, "r", errors="replace") as fh:
        for line in fh:
            p = parse(line)
            if p:
                entries.append(p)
        if entries:
            report(entries[0], entries[-1], total)
        else:
            print("no [progress] lines yet")
        if not follow:
            return 0
        # follow mode
        while True:
            line = fh.readline()
            if not line:
                time.sleep(1.0)
                continue
            p = parse(line)
            if p:
                entries.append(p)
                report(entries[0], entries[-1], total)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
