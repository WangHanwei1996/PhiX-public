{
    // PFHub Benchmark 2a — Ostwald ripening (CH + 4 AC), 200x200 periodic
    // solver: applications/solvers/CH_4AC_Ostwald/2D
    "mesh": {
        "nx": 200, "dx": 1.0, "x0": 0.0,
        "ny": 200, "dy": 1.0, "y0": 0.0
    },

    "initialize": {
        "start_from": "initial_field",   // gen_initial_field.py 产物
        "dt"    : 1.5e-3,                // 显式 CH 稳定极限 dx^4/(32*M*kappa_c) ≈ 2.1e-3
        "nSteps": 667000                 // t_end ≈ 1000
    },

    "boundary_conditions": {
        "x_min": "Periodic", "x_max": "Periodic",
        "y_min": "Periodic", "y_max": "Periodic"
    },

    "constants": {
        "rho"      : 1.4142135623730951,   // sqrt(2), rho^2 = 2
        "ca"       : 0.3,
        "cb"       : 0.7,
        "kappa_c"  : 3.0,
        "kappa_eta": 3.0,
        "M"        : 5.0,
        "L"        : 5.0,
        "w"        : 1.0,
        "alpha"    : 5.0
    },

    "pfhub": {
        "energy_interval": 3335,          // 每 t≈5 记一行 F(t)
        "csv": "free_energy.csv"
    },

    "output": {
        "print_interval": 66700,
        "write_interval": 333500,
        "format"        : "VTS"
    }
}
